{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portfolio",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      // Self-reference, so the revalidation queue can call back into this
      // Worker. The service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portfolio"
    }
  ],

  // Incremental cache for the prerendered page. Create it once with:
  //   npx wrangler r2 bucket create portfolio-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "portfolio-cache"
    }
  ],

  // Dedupes and runs the six-hourly background revalidation. Needs no manual
  // setup — the class ships with the adapter and the migration below creates it.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],

  "images": {
    // Request-time image optimisation.
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true
  }
}
